# =============================================================================
# Variabili d'ambiente del progetto Bando AI
# =============================================================================
# ISTRUZIONI:
# 1. Copia questo file e rinominalo in ".env"
# 2. Compila i valori con le tue credenziali
# 3. NON caricare mai il file .env su Git
# =============================================================================

# --- n8n ---
N8N_RUNNERS_AUTH_TOKEN=inserisci_un_token_sicuro_qui

# --- MongoDB ---
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=inserisci_password_sicura_qui

# --- Mongo Express ---
ME_BASICAUTH_USERNAME=admin
ME_BASICAUTH_PASSWORD=inserisci_password_qui
